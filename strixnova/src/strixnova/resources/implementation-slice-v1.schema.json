{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.implementation-slice.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "purpose",
    "implements",
    "operation_refs",
    "depends_on",
    "parallel_safe_with",
    "completion_criteria",
    "verification_command_refs",
    "rollback_or_recovery"
  ],
  "properties": {
    "schema_version": {
      "const": "strixnova.implementation-slice.v1"
    },
    "slice_id": {
      "type": "string",
      "pattern": "^SLICE-[0-9]{3,}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^operations\\[[0-9]+\\]$"
      }
    },
    "continued_operation_refs": {
      "description": "仅用于一个后续切片刷新同一份已规划的实现对齐草稿；不转移原操作归属，不允许普通源码或其他长期权威跨切片重写。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^operations\\[[0-9]+\\]$"
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SLICE-[0-9]{3,}$"
      }
    },
    "parallel_safe_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SLICE-[0-9]{3,}$"
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_command_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^verification_commands\\[[0-9]+\\]$"
      }
    },
    "rollback_or_recovery": {
      "type": "string",
      "minLength": 1
    }
  }
}
