{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.repository-delivery-responsibility.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "plan_id",
    "investigation_commit",
    "target_ref",
    "operation_refs",
    "implementation_slice_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "strixnova.repository-delivery-responsibility.v1"
    },
    "repository_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^REPO-[0-9A-F]{16}$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "investigation_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "target_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "operation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^operations\\[[0-9]+\\]$"
      }
    },
    "implementation_slice_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "git": {
      "type": "object"
    }
  }
}
