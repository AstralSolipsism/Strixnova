{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.review-context-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "repositories"
  ],
  "properties": {
    "schema_version": {
      "const": "strixnova.review-context-request.v1"
    },
    "mode": {
      "enum": [
        "changes",
        "modules"
      ]
    },
    "basis_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable authority basis in the configuration repository; omitted uses its configured integration ref."
    },
    "bindings": {
      "type": "object",
      "description": "Existing project-bindings.v1 contract, independently validated by the project resolver."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "ref"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^REPO-[0-9A-F]{16}$"
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "description": "Commit/ref to read; null explicitly selects the current working tree."
          },
          "base_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "module_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^MODULE-[0-9A-F]{16}$"
      }
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "max_content_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 8192,
      "maximum": 2097152
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "changes"
          }
        }
      },
      "then": {
        "properties": {
          "repositories": {
            "items": {
              "required": [
                "base_ref"
              ]
            }
          }
        }
      },
      "else": {
        "required": [
          "module_ids"
        ],
        "properties": {
          "module_ids": {
            "minItems": 1
          },
          "repositories": {
            "items": {
              "not": {
                "required": [
                  "base_ref"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
