{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.semantic-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "reviewed_refs",
    "checks",
    "findings",
    "question_budget",
    "semantic_content_machine_proven"
  ],
  "properties": {
    "schema_version": {
      "const": "strixnova.semantic-review.v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^SEMREVIEW-[0-9A-F]{16}$"
    },
    "reviewed_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "question_budget": {
      "$ref": "#/$defs/question_budget"
    },
    "semantic_content_machine_proven": {
      "const": false
    }
  },
  "$defs": {
    "perspective": {
      "enum": [
        "product_to_domain_coverage",
        "terminology_authority_rules_invariants",
        "domain_to_architecture_disposition",
        "plan_and_slice_coverage",
        "orphan_and_authority_inversion",
        "scenario_coverage",
        "nonfunctional_and_risk_coverage",
        "evidence_and_claim_boundaries"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perspective",
        "status",
        "summary",
        "evidence_refs",
        "finding_ids"
      ],
      "properties": {
        "perspective": {
          "$ref": "#/$defs/perspective"
        },
        "status": {
          "enum": [
            "aligned",
            "finding",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FINDING-[0-9]{3,}$"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "perspective",
        "severity",
        "status",
        "locations",
        "statement",
        "impact",
        "recommendation",
        "owner_decision_required",
        "decision_refs",
        "resolution"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^FINDING-[0-9]{3,}$"
        },
        "perspective": {
          "$ref": "#/$defs/perspective"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted_risk"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "owner_decision_required": {
          "type": "boolean"
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "question_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_questions",
        "questions_asked",
        "resolved_decision_refs",
        "remaining_high_impact_decisions"
      ],
      "properties": {
        "maximum_questions": {
          "const": 5
        },
        "questions_asked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "resolved_decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remaining_high_impact_decisions": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
