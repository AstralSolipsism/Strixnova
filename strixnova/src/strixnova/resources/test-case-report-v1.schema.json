{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.test-case-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "adapter",
    "adapter_sha256",
    "test_root",
    "collection_complete",
    "session_finished",
    "exit_status",
    "collected_test_ids",
    "deselected_test_ids",
    "collection_errors",
    "results",
    "framework_version",
    "python_version"
  ],
  "properties": {
    "schema_version": {
      "const": "strixnova.test-case-report.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "adapter": {
      "const": "pytest"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "collection_complete": {
      "type": "boolean"
    },
    "session_finished": {
      "type": "boolean"
    },
    "exit_status": {
      "type": "integer"
    },
    "collected_test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "deselected_test_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 0,
      "maxItems": 100000,
      "uniqueItems": true
    },
    "collection_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "phase",
          "outcome",
          "expected_failure"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "phase": {
            "enum": [
              "setup",
              "call",
              "teardown"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "expected_failure": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "framework_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "python_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
