{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strixnova.work-item-relation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_work_item_id",
    "relation_type",
    "reason"
  ],
  "properties": {
    "target_work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "related_to",
        "part_of",
        "depends_on",
        "follows_up",
        "supersedes"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "follow_up_refs": {
      "type": "array",
      "items": {
        "$ref": "follow-up-records-v1.schema.json#/$defs/reference"
      }
    }
  }
}
