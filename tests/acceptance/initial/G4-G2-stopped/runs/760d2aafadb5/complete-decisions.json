              }
            ],
            "capability_refs": [],
            "context_ref": null,
            "guardrail_dispositions": []
          },
          "goal": "扩展预约申请工具：支持成员撤回本人处于待审核状态的预约申请（先行推进第一成果）",
          "non_goals": [
            "本轮不实现已批准预约的取消、变更或重新审批流程。",
            "周报下载汇总作为独立待办事项（WI-20260928-DB4C76AE）分别交付，不在本事项实施业务代码。",
            "不增加网页端或网络远程服务，不实现缴费或通知外发。"
          ],
          "schema_version": "strixnova.direction-decision.v1",
          "scope": [
            {
              "requirement_id": "DIRREQ-A100000000000001",
              "statement": "成员可撤回本人发起的处于待审核状态的预约申请，不信任传入角色或所有者字段。"
            },
            {
              "requirement_id": "DIRREQ-A100000000000002",
              "statement": "撤回操作具备幂等性（重复撤回返回相同结果且不重复记审计），并在与审批并发时通过版本并发控制只允许一个版本成功；响应丢失后可查询实际状态；审计记录操作者、原状态、新状态和操作身份。"
            },
            {
              "requirement_id": "DIRREQ-A100000000000003",
              "statement": "申请身份、状态含义和决定权作为与周报单元共享的核心规范；界面交互严格限定为本地终端交互。"
            }
          ],
          "tradeoffs": [
            "优先单点交付高确定性的成员撤回价值成果，周报汇总拆单独立跟进，解耦交付节奏并降低单次变更风险。"
          ],
          "work_item_relations": [
            {
              "reason": "共用同一预约申请领域上下文与底层时长组件，但作为独立结果分别交付。",
              "relation_type": "related_to",
              "target_work_item_id": "WI-20260928-DB4C76AE"
            }
          ]
