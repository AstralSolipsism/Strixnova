          ],
          "constraints": [
            {
              "constraint_id": "DIRCON-A100000000000001",
              "statement": "只能由可信宿主会话提供操作者身份，严禁信任传入的角色或所有者字段。"
            },
            {
              "constraint_id": "DIRCON-A100000000000002",
              "statement": "成员撤回与运营审批必须有并发保护，只允许一个状态流转成功。"
            },
            {
              "constraint_id": "DIRCON-A100000000000003",
              "statement": "界面交互严格限定为本地终端交互，不引入Web或网络服务。"
