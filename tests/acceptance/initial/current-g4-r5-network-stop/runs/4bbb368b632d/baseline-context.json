    "engineering_methods": [
      {
        "method_id": "ddd",
        "display_name": "Domain-Driven Design",
        "category": "domain_modeling",
        "source_ids": [
          "DDD-REFERENCE-2015"
        ],
        "purpose": "让项目长期领域模型、团队语言与软件边界围绕真实问题领域保持一致。",
        "consider_when": [
          "domain",
          "architecture",
          "interface",
          "data"
        ],
        "strixnova_interpretation": "项目采用 DDD 时先维护全局统一语言、限界上下文、领域不变量和上下文关系；具体 WorkItem 只记录本次相关应用，不因方法名称自动扩大流程或提高保障等级。",
        "techniques": [
          {
            "technique_id": "ubiquitous_language",
            "display_name": "统一语言",
            "basis": "source",
            "purpose": "让同一上下文中的用户、Agent、工程产物和实现使用一致术语。"
          },
          {
            "technique_id": "bounded_context",
            "display_name": "限界上下文",
            "basis": "source",
            "purpose": "明确一个领域模型和语言在哪个责任范围内有效。"
          },
          {
            "technique_id": "context_map",
            "display_name": "上下文映射",
            "basis": "source",
            "purpose": "明确不同限界上下文之间的真实工程关系。"
          },
          {
            "technique_id": "domain_invariant_trace",
            "display_name": "领域不变量追溯",
            "basis": "strixnova_interpretation",
            "purpose": "把必须始终成立的领域规则连接到上下文和代表性源码、测试或长期工程证据。"
          }
        ],
        "project_adoption_requires": [
          "ubiquitous_language",
          "bounded_context",
          "context_map",
          "domain_invariant_trace"
        ],
        "evidence_expectations": [
          "全局领域模型有稳定身份",
          "限界上下文和不变量有代表性源码、测试及长期工程文件证据",
          "实现对齐状态与已知差距明确",
          "WorkItem 只在真实相关时记录具体方法应用"
        ]
      }
    ],
