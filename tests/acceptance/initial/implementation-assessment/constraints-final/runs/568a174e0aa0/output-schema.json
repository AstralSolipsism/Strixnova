{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "optional_text_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "test",
            "artifact",
            "command",
            "inspection"
          ]
        },
        "ref": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deviation_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deviation_id"
      }
    },
    "deviation_id": {
      "type": "string",
      "pattern": "^DEVIATION-[0-9A-F]{16}$"
    }
  },
  "required": [
    "assessments",
    "source_ownership",
    "owner_accepted",
    "semantic_content_machine_proven"
  ],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "status",
          "satisfied",
          "missing",
          "evidence",
          "deviation_ids",
          "resolution_plan",
          "limitations"
        ],
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "constraint"
            ]
          },
          "target_id": {
            "type": "string",
            "enum": [
              "CONSTRAINT-F1C702A492724B6E",
              "CONSTRAINT-FB4D1ACCCD784006",
              "CONSTRAINT-04375F7A76854A93",
              "CONSTRAINT-22AEADF3D7FA42C1",
              "CONSTRAINT-3FA770501B6147B4",
              "CONSTRAINT-671EC292D1E141AD",
              "CONSTRAINT-73FD747C76A44544",
              "CONSTRAINT-773E501C7BE448EF",
              "CONSTRAINT-A1D7C29B7D604635"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "partially_implemented",
              "not_implemented",
              "drifted",
              "unknown"
            ]
          },
          "satisfied": {
            "$ref": "#/$defs/optional_text_list"
          },
          "missing": {
            "$ref": "#/$defs/optional_text_list"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          },
          "deviation_ids": {
            "$ref": "#/$defs/deviation_id_list"
          },
          "resolution_plan": {
            "$ref": "#/$defs/optional_text_list"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "properties": {
                "missing": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "missing": {
                  "minItems": 1
                },
                "resolution_plan": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "source_ownership": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "type": "object"
      }
    },
    "owner_accepted": {
      "const": false
    },
    "semantic_content_machine_proven": {
      "const": false
    }
  }
}
