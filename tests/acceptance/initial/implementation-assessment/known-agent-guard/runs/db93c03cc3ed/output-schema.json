{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "optional_text_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "test",
            "artifact",
            "command",
            "inspection"
          ]
        },
        "ref": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deviation_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deviation_id"
      }
    },
    "deviation_id": {
      "type": "string",
      "pattern": "^DEVIATION-[0-9A-F]{16}$"
    }
  },
  "required": [
    "assessments",
    "source_ownership",
    "owner_accepted",
    "semantic_content_machine_proven"
  ],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "status",
          "satisfied",
          "missing",
          "evidence",
          "deviation_ids",
          "resolution_plan",
          "limitations"
        ],
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "module"
            ]
          },
          "target_id": {
            "type": "string",
            "enum": [
              "MODULE-6DEF61048B394531",
              "MODULE-71687954FB1E4DFD",
              "MODULE-8205A05A6F5E48A8"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "partially_implemented",
              "not_implemented",
              "drifted",
              "unknown"
            ]
          },
          "satisfied": {
            "$ref": "#/$defs/optional_text_list"
          },
          "missing": {
            "$ref": "#/$defs/optional_text_list"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          },
          "deviation_ids": {
            "$ref": "#/$defs/deviation_id_list"
          },
          "resolution_plan": {
            "$ref": "#/$defs/optional_text_list"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "properties": {
                "missing": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "missing": {
                  "minItems": 1
                },
                "resolution_plan": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "source_ownership": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "target_module_id",
          "current_status",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "strixnova/src/strixnova/process_supervisor.py",
              "strixnova/src/strixnova/resources/agent-skill/strixnova/references/authority-authoring.md",
              "strixnova/src/strixnova/resources/agent-skill/strixnova/references/engineering-policy-contracts.md",
              "strixnova/src/strixnova/project_engineering_policy.py"
            ]
          },
          "target_module_id": {
            "type": "string",
            "enum": [
              "MODULE-6DEF61048B394531",
              "MODULE-71687954FB1E4DFD",
              "MODULE-8205A05A6F5E48A8"
            ]
          },
          "current_status": {
            "type": "string",
            "enum": [
              "aligned",
              "partially_aligned",
              "drifted",
              "unknown",
              "not_applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owner_accepted": {
      "const": false
    },
    "semantic_content_machine_proven": {
      "const": false
    }
  }
}
