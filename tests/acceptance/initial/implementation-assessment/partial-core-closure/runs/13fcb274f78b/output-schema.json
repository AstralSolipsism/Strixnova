{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "optional_text_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "test",
            "artifact",
            "command",
            "inspection"
          ]
        },
        "ref": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deviation_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deviation_id"
      }
    },
    "deviation_id": {
      "type": "string",
      "pattern": "^DEVIATION-[0-9A-F]{16}$"
    }
  },
  "required": [
    "assessments",
    "source_ownership",
    "owner_accepted",
    "semantic_content_machine_proven"
  ],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "status",
          "satisfied",
          "missing",
          "evidence",
          "deviation_ids",
          "resolution_plan",
          "limitations"
        ],
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "module"
            ]
          },
          "target_id": {
            "type": "string",
            "enum": [
              "MODULE-159AE7957218470C",
              "MODULE-5CEF109E340C469F",
              "MODULE-684D0E7D2345445D"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "partially_implemented",
              "not_implemented",
              "drifted",
              "unknown"
            ]
          },
          "satisfied": {
            "$ref": "#/$defs/optional_text_list"
          },
          "missing": {
            "$ref": "#/$defs/optional_text_list"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          },
          "deviation_ids": {
            "$ref": "#/$defs/deviation_id_list"
          },
          "resolution_plan": {
            "$ref": "#/$defs/optional_text_list"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "properties": {
                "missing": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "missing": {
                  "minItems": 1
                },
                "resolution_plan": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "source_ownership": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "target_module_id",
          "current_status",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "strixnova/src/strixnova/agent_setup.py",
              "strixnova/src/strixnova/application_coordinator.py",
              "strixnova/src/strixnova/implementation_alignment_artifacts.py",
              "strixnova/src/strixnova/implementation_alignment_preparation.py",
              "strixnova/src/strixnova/implementation_candidate_evidence.py",
              "strixnova/src/strixnova/project_authority_decision.py",
              "strixnova/src/strixnova/resources/agent-skill/strixnova/references/behavior-examples.md",
              "strixnova/src/strixnova/behavior_examples.py",
              "strixnova/src/strixnova/engineering_change_planning.py",
              "strixnova/src/strixnova/engineering_governance.py",
              "strixnova/src/strixnova/project_engineering_assurance.py",
              "strixnova/src/strixnova/resources/authority-change-set-v1.schema.json",
              "strixnova/src/strixnova/resources/behavior-example-v1.schema.json",
              "strixnova/src/strixnova/resources/engineering-assessment-v1.schema.json",
              "strixnova/src/strixnova/resources/engineering-plan-v1.schema.json",
              "strixnova/src/strixnova/resources/implementation-slice-v1.schema.json",
              "strixnova/src/strixnova/resources/owner-view-v1.schema.json",
              "strixnova/src/strixnova/resources/project-authority-review-submission-v1.schema.json",
              "strixnova/src/strixnova/resources/project-engineering-assurance-v1.schema.json",
              "strixnova/src/strixnova/resources/replan-request-v1.schema.json",
              "strixnova/src/strixnova/resources/semantic-review-v1.schema.json",
              "strixnova/src/strixnova/resources/target-advance-assessment-v1.schema.json",
              "strixnova/src/strixnova/resources/verification-targets-v1.schema.json",
              "strixnova/src/strixnova/verification_targets.py",
              "strixnova/src/strixnova/actual_result.py",
              "strixnova/src/strixnova/confirmation_protocol.py",
              "strixnova/src/strixnova/current_action.py",
              "strixnova/src/strixnova/execution_stop_evidence.py",
              "strixnova/src/strixnova/follow_ups.py",
              "strixnova/src/strixnova/persistent_evidence.py",
              "strixnova/src/strixnova/project_authority_progress.py",
              "strixnova/src/strixnova/project_maintenance.py",
              "strixnova/src/strixnova/resources/actual-result-v1.schema.json",
              "strixnova/src/strixnova/resources/current-action-v1.schema.json",
              "strixnova/src/strixnova/resources/direction-decision-v1.schema.json",
              "strixnova/src/strixnova/resources/execution-stop-evidence-v1.schema.json",
              "strixnova/src/strixnova/resources/follow-up-records-v1.schema.json",
              "strixnova/src/strixnova/resources/repository-delivery-responsibility-v1.schema.json",
              "strixnova/src/strixnova/resources/work-item-relation-v1.schema.json",
              "strixnova/src/strixnova/resources/work-item-v1.schema.json",
              "strixnova/src/strixnova/storage_formats.py",
              "strixnova/src/strixnova/work_item_relations.py",
              "strixnova/src/strixnova/work_item_repositories.py",
              "strixnova/src/strixnova/workflow_authority.py"
            ]
          },
          "target_module_id": {
            "type": "string",
            "enum": [
              "MODULE-159AE7957218470C",
              "MODULE-5CEF109E340C469F",
              "MODULE-684D0E7D2345445D"
            ]
          },
          "current_status": {
            "type": "string",
            "enum": [
              "aligned",
              "partially_aligned",
              "drifted",
              "unknown",
              "not_applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owner_accepted": {
      "const": false
    },
    "semantic_content_machine_proven": {
      "const": false
    }
  }
}
