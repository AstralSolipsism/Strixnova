{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "optional_text_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "test",
            "artifact",
            "command",
            "inspection"
          ]
        },
        "ref": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "deviation_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/deviation_id"
      }
    },
    "deviation_id": {
      "type": "string",
      "pattern": "^DEVIATION-[0-9A-F]{16}$"
    }
  },
  "required": [
    "assessments",
    "source_ownership",
    "owner_accepted",
    "semantic_content_machine_proven"
  ],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "status",
          "satisfied",
          "missing",
          "evidence",
          "deviation_ids",
          "resolution_plan",
          "limitations"
        ],
        "properties": {
          "target_kind": {
            "type": "string",
            "enum": [
              "relationship"
            ]
          },
          "target_id": {
            "type": "string",
            "enum": [
              "RELATION-CDC41CEBF40D49A5",
              "RELATION-D30AE8CE877C462F",
              "RELATION-D4E5FF14DCD0494C",
              "RELATION-D7C6624612F34880",
              "RELATION-D9A7FFF677B8411B",
              "RELATION-E7B2B284E1684007",
              "RELATION-E908CF39D78845DF",
              "RELATION-E98DCC2FA1624DB7",
              "RELATION-F3A4968600194593",
              "RELATION-F81E17FC24D54C3E",
              "RELATION-FC3CADC92F0245FC",
              "RELATION-FC78A19148854EBE"
            ]
          },
          "status": {
            "enum": [
              "implemented",
              "partially_implemented",
              "not_implemented",
              "drifted",
              "unknown"
            ]
          },
          "satisfied": {
            "$ref": "#/$defs/optional_text_list"
          },
          "missing": {
            "$ref": "#/$defs/optional_text_list"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1
          },
          "deviation_ids": {
            "$ref": "#/$defs/deviation_id_list"
          },
          "resolution_plan": {
            "$ref": "#/$defs/optional_text_list"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "properties": {
                "missing": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "missing": {
                  "minItems": 1
                },
                "resolution_plan": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "source_ownership": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "type": "object"
      }
    },
    "owner_accepted": {
      "const": false
    },
    "semantic_content_machine_proven": {
      "const": false
    }
  }
}
